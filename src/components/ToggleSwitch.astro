---
import { Icon } from 'astro-icon/components'
---

<label class="theme-switch" aria-label="Cambiar a modo claro">
  <input class="toggle" type="checkbox" />
  <span class="toggle-track">
    <span class="toggle-thumb">
      <Icon name="moon" size={14} class="icon-moon" />
      <Icon name="sun" size={14} class="icon-sun" />
    </span>
  </span>
</label>

<style>
  /* Zona táctil de 64×44 con el track de 56×30 centrado */
  label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 44px;
    cursor: pointer;
    vertical-align: middle;

    & input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    &:has(input:focus-visible) .toggle-track {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }
  }

  .toggle-track {
    display: flex;
    align-items: center;
    width: 56px;
    height: 30px;
    padding: 3px;
    box-sizing: border-box;
    background-color: var(--track);
    border-radius: 99px;
    transition: var(--transition-bg);
  }

  /* El thumb se desliza 26px; .active = tema claro */
  .toggle-thumb {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--accent-color);
    color: var(--bg-color);
    transition:
      transform 0.3s ease,
      var(--transition-bg);

    & :global(svg) {
      grid-area: 1 / 1;
    }

    & :global(.icon-sun) {
      display: none;
    }

    &.active {
      transform: translateX(26px);

      & :global(.icon-sun) {
        display: block;
      }

      & :global(.icon-moon) {
        display: none;
      }
    }
  }
</style>
