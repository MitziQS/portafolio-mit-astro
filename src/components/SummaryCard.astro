---
interface Props {
  label: string
  title?: string
  text: string
  place?: 'side' | 'full'
}

const { label, title, text, place } = Astro.props

// Una sola frase corta (p. ej. «Product Designer» o «2023») se muestra en serif
const plain = text.replace(/<[^>]*>/g, '').trim()
const isShort =
  title === undefined &&
  (text.match(/<p\b/g) ?? []).length === 1 &&
  !/<(ul|ol|div|br)\b/.test(text) &&
  plain.length <= 32
---

<article
  class:list={[
    'summary-card',
    {
      'summary-card--full': place === 'full',
      'summary-card--short': isShort
    }
  ]}
>
  <p class="summary-card__eyebrow">{label}</p>
  {
    title && (
      <p>
        <strong>{title}</strong>
      </p>
    )
  }
  <Fragment set:html={text} />
</article>
