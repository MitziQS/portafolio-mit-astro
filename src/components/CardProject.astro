---
import { accentHtml } from '@utils/accent'
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { Picture } from 'astro:assets'

interface Props {
  src: string
  alt: string
  title: string
  accent?: string
  label: string
  description: string
  techs: string[]
  preview: string
  href: string
  index: number
  total: number
  color: string
}

const {
  src,
  alt,
  title,
  accent,
  label,
  description,
  techs,
  preview,
  href,
  index,
  total,
  color
} = Astro.props

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/projects/**/*.{jpeg,jpg,png}'
)
if (!images[src]) {
  throw new Error(
    `"${src}" no existe en: "/src/images/projects/**/*.{jpeg,jpg,png}"`
  )
}

const pad = (n: number): string => String(n).padStart(2, '0')
---

<article class="card-project" style={`--project-color: ${color}`}>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    <Picture
      src={images[src]()}
      alt={alt}
      width={720}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
    />
  </a>

  <div class="description">
    <p class="meta">
      <span class="label eyebrow">
        <span class="swatch" aria-hidden="true"></span>
        {label}
      </span>
      <span class="counter">{pad(index)} / {pad(total)}</span>
    </p>

    <h3 class="card-title">
      <a href={href} set:html={accentHtml(title, accent)} />
    </h3>

    <p class="card-desc">{description}</p>

    <ul class="chips" aria-label="Herramientas">
      {
        techs.map((tech) => {
          const techLower = tech.toLowerCase().replaceAll(' ', '-')
          return (
            <li>
              <Icon name={`techs/${techLower}`} size={18} />
              <span>{tech}</span>
            </li>
          )
        })
      }
    </ul>

    <a class="case-link" href={href}>{preview}</a>
  </div>
</article>

<style>
  .card-project {
    display: grid;
    gap: var(--space-5);
    align-items: center;

    @media (width >= 900px) {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 8%;
    background-color: var(--project-color);
    border-radius: var(--radius);
    overflow: hidden;

    & img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-media);
      box-shadow: 0 20px 40px -20px rgb(0 0 0 / 55%);
      transition: scale 400ms ease;
    }

    @media (any-hover: hover) {
      &:hover img {
        scale: 1.02;
      }
    }
  }

  .description {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    width: 100%;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .swatch {
    width: 10px;
    height: 10px;
    background-color: var(--project-color);
    border-radius: 2px;
  }

  .counter {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted-color);
  }

  .card-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: var(--w-semibold);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);

    & a {
      color: inherit;
      text-decoration: none;
    }
  }

  .card-desc {
    color: var(--text-description-color);
    font-size: var(--text-lg);
    line-height: var(--leading-base);
    text-wrap: pretty;
    transition: var(--transition-text);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;

    & li {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: 4px var(--space-2);
      font-size: var(--text-sm);
      color: var(--text-description-color);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-pill);
      transition: var(--transition-border), var(--transition-text);
    }
  }

  .case-link {
    font-weight: var(--w-medium);
    color: var(--accent-color);
    text-decoration: none;
    transition: var(--transition-text);

    &:hover,
    &:focus-visible {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>
