---
import { Icon } from 'astro-icon/components'
import { t } from 'i18n:astro'

const links = t('links', { returnObjects: true }) as {
  linkedin: string
  email: string
}
---

<aside class="socials">
  <nav>
    <a href={links.linkedin} aria-label="LinkedIn">
      <Icon name="linkedin" size={28} />
    </a>
    <a href={`mailto:${links.email}`} aria-label="Correo">
      <Icon name="mail" size={28} />
    </a>
  </nav>
</aside>

<style>
  .socials {
    display: none;

    /* Solo cuando hay espacio a los lados del contenido de 1280px */
    @media (width >= 1440px) {
      display: initial;
      position: fixed;
      bottom: 0;
      left: 0;
      translate: 46px;

      & nav {
        display: flex;
        gap: var(--space-4);
        flex-direction: column;

        &::after {
          content: '';
          background-color: var(--border-color);
          width: 1px;
          height: 127px;
          margin-inline: auto;
        }

        & a {
          color: var(--text-muted-color);
          text-decoration: none;
          transition: var(--transition-text);

          &:hover {
            color: var(--accent-color);
          }
        }
      }
    }
  }
</style>
