---
import { t } from 'i18n:astro'
import { URL } from '@data/constants'
import Layout from '@layouts/Layout.astro'
import About from '@pages/_home/About.astro'
import Contact from '@pages/_home/Contact.astro'
import Experience from '@pages/_home/Experience.astro'
import Hero from '@pages/_home/Hero.astro'
import Projects from '@pages/_home/Projects.astro'
import Marquee from '@components/Marquee.astro'
import OpenGraph from '@components/OpenGraph.astro'

const options = {
  title: t('common:title'),
  description: t('common:description')
}
---

<Layout options={options}>
  <OpenGraph information={options} image=`${URL}/og/mitzi-soria-og.png` />

  <main>
    <Hero />
    <Marquee />
    <Projects />
    <About />
    <Experience />
    <Contact />
  </main>
</Layout>

<style>
  main {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--mobile-inline-padding);

    @media (width >= 1344px) {
      padding-inline: 0;
    }

    /* Secciones separadas por una línea; el marquee ya trae sus propios bordes */
    & > :global(section:not(.hero, .marquee, .marquee + section)) {
      border-top: 1px solid var(--border-color);
      transition: var(--transition-border);
    }

    & > :global(section:not(.hero, .marquee)) {
      padding-block: var(--section-space);
    }
  }
</style>
