---
import { Icon } from 'astro-icon/components'
import { t } from 'i18n:astro'
import Button from '@components/Button.astro'

const {
  job_availability: jobAvailability,
  title,
  job_title: jobTitle,
  description,
  cta_projects: ctaProjects,
  cta_cv: ctaCv,
  scroll_hint: scrollHint
} = t('hero', {
  returnObjects: true
})
const links = t('links', { returnObjects: true }) as {
  linkedin: string
  cv: string
}
---

<section class="hero">
  <div class="frame">
    <div class="badge glass">
      <span class="dot"></span>
      <span>{jobAvailability}</span>
    </div>
    <h1 set:html={title} />
    <div class="intro">
      <p class="job-title" set:html={jobTitle} />
      <p>{description}</p>
    </div>
    <div class="button-container">
      <Button class="filled" href="#proyectos">{ctaProjects}</Button>
      <Button class="glass" href={links.cv} download>
        <Icon name="file" size={20} />
        <span>{ctaCv}</span>
      </Button>
      <Button class="glass" href={links.linkedin}>
        <Icon name="linkedin" size={20} />
        <span>LinkedIn</span>
      </Button>
    </div>
    <a class="scroll-hint" href="#proyectos">{scrollHint}</a>
    <canvas id="stars"></canvas>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-5);
    padding-bottom: var(--section-space);

    @media (width >= 1024px) {
      padding-top: var(--space-6);
    }
  }

  .frame {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    transition: var(--transition-border);

    & canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.6;
      z-index: -1;
      pointer-events: none;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 6px var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-description-color);
    border-radius: var(--radius-pill);

    & .dot {
      --size: 8px;

      width: var(--size);
      height: var(--size);
      background-color: var(--status-color);
      border-radius: 50%;
      box-shadow: 0 0 0 0 var(--status-color);
      animation: pulse 2s infinite;
    }
  }

  h1 {
    max-width: 15ch;
  }

  .intro {
    display: grid;
    gap: var(--space-2);
    max-width: 58ch;
    font-size: var(--text-lg);
    color: var(--text-description-color);
    transition: var(--transition-text);

    & :global(strong) {
      color: var(--text-color);
    }
  }

  .button-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .scroll-hint {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted-color);
    text-decoration: none;
    transition: var(--transition-text);

    &:hover,
    &:focus-visible {
      color: var(--accent-color);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 var(--status-glow-color);
    }

    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px transparent;
    }

    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>

<script>
  import { StarField } from '@scripts/starfield'

  const canvas = document.querySelector('#stars') as HTMLCanvasElement
  new StarField(canvas)
</script>
