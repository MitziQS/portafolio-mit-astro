---
import mit from '@images/mit.jpeg'
import { Picture } from 'astro:assets'
import { t } from 'i18n:astro'

const about = t('about', { returnObjects: true })
const { title, eyebrow, headline, subtitle } = about
// Siempre como array:
const paragraphs = Array.isArray(about.description)
  ? about.description
  : [about.description]

const normalizeTitle = title
  .toLowerCase()
  .replaceAll(' ', '-')
  .normalize('NFD')
  .replace(/\p{Diacritic}/gu, '') // elimina acentos
---

<section id={normalizeTitle} class="about">
  <div class="intro">
    <p class="eyebrow">{eyebrow}</p>
    <h2 set:html={headline} />
    <div class="picture">
      <Picture
        src={mit}
        alt="Mitzi Soria"
        width={366}
        height={361}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
      />
    </div>
  </div>

  <div class="description">
    <p class="lead">{subtitle}</p>
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-6);

    @media (width >= 900px) {
      grid-template-columns: 5fr 7fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .intro {
    display: grid;
    align-content: start;
    gap: var(--space-4);

    & h2 {
      max-width: 14ch;
    }
  }

  .picture {
    margin-top: var(--space-3);
    max-width: 320px;

    & img {
      width: 100%;
      height: auto;
      border-radius: var(--radius);
      border: 1px solid var(--border-color);
      transition: var(--transition-border);
    }
  }

  .description {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    color: var(--text-description-color);
    transition: var(--transition-text);

    & p {
      text-wrap: pretty;
    }

    & .lead {
      font-size: var(--text-2xl);
      line-height: 1.4;
      letter-spacing: var(--tracking-heading);
      color: var(--text-color);
    }
  }
</style>
