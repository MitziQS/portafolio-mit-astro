---
import { Icon } from 'astro-icon/components'
import { t } from 'i18n:astro'

const {
  title,
  subtitle,
  email_label: emailLabel,
  linkedin_label: linkedinLabel,
  cv_label: cvLabel,
  cv_value: cvValue
} = t('contact', { returnObjects: true })
const links = t('links', { returnObjects: true }) as {
  linkedin: string
  email: string
  cv: string
}
---

<section class="contact">
  <div class="box">
    <h2 set:html={title} />
    <p class="subtitle">{subtitle}</p>
    <ul class="links">
      <li>
        <a href={`mailto:${links.email}`}>
          <Icon name="mail" size={22} />
          <span>{emailLabel}</span>
          <span class="value">{links.email}</span>
        </a>
      </li>
      <li>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" size={22} />
          <span>{linkedinLabel}</span>
          <span class="value">/in/soria-mitzi</span>
        </a>
      </li>
      <li>
        <a href={links.cv} download>
          <Icon name="file" size={22} />
          <span>{cvLabel}</span>
          <span class="value">{cvValue}</span>
        </a>
      </li>
    </ul>
    <canvas id="grid"></canvas>
  </div>
</section>

<style>
  .box {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 6vw, 5rem);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
    transition: var(--transition-border);

    & canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      opacity: 0.45;
      pointer-events: none;
    }
  }

  h2 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 14ch;
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--text-description-color);
    transition: var(--transition-text);
  }

  .links {
    display: grid;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-color);

    & a {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding-block: var(--space-3);
      color: var(--text-color);
      text-decoration: none;
      border-bottom: 1px solid var(--border-color);
      transition: var(--transition-text), var(--transition-border);

      &:hover,
      &:focus-visible {
        color: var(--accent-color);
      }
    }

    & .value {
      margin-left: auto;
      font-size: var(--text-sm);
      color: var(--text-muted-color);
      overflow-wrap: anywhere;
      text-align: right;
    }
  }
</style>

<script>
  import { GridField } from '@scripts/gridfield'

  const canvas = document.querySelector('#grid') as HTMLCanvasElement

  if (canvas) {
    const gridField = new GridField(canvas)

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Inicia la animación cuando el canvas entra en la vista
            gridField.play()
            // Deja de observar el canvas
            observer.unobserve(canvas)
          }
        })
      },
      {
        // Activar cuando al menos el 50% del canvas sea visible
        threshold: 0.5
      }
    )

    // Observa el canvas
    observer.observe(canvas)
  } else {
    // Mensaje de error si no se encuentra el canvas
    console.error("No se encontró el elemento 'canvas'")
  }
</script>
