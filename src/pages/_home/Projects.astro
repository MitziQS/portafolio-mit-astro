---
import { accentHtml } from '@utils/accent'
import { getCollection } from 'astro:content'
import { t } from 'i18n:astro'
import CardProject from '@components/CardProject.astro'

const { title, preview } = t('projects', {
  returnObjects: true
})

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.card.order - b.data.card.order
)

// Colores de bloque en orden: terracota, añil, verde
const colors = ['--block-terracota', '--block-anil', '--block-verde']
---

<section id="proyectos" class="projects">
  <h2 set:html={accentHtml(title)} />
  <div class="list">
    {
      projects.map(({ slug, data }, index) => (
        <CardProject
          src={data.card.image}
          alt={data.title}
          title={data.title}
          accent={data.card.accent}
          label={data.company ?? data.title}
          description={data.card.summary}
          techs={data.card.techs}
          preview={preview}
          href={`/projects/${slug}`}
          index={index + 1}
          total={projects.length}
          color={`var(${colors[index % colors.length]})`}
        />
      ))
    }
  </div>
</section>

<style>
  h2 {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    white-space: nowrap;
    margin-bottom: var(--section-space);

    &::after {
      content: '';
      display: block;
      width: 100%;
      height: 1px;
      background-color: var(--border-color);
      transition: var(--transition-bg);
    }
  }

  .list {
    display: grid;
    gap: 96px;
  }
</style>
