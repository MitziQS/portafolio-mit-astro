---
import { accentHtml } from '@utils/accent'
import { t } from 'i18n:astro'

interface Job {
  title: string
  company: string
  organization?: string
  location?: string
  time: string[]
  description?: string
  list: string[]
}

const experienceData = t('experience', {
  returnObjects: true
}) as unknown as {
  title: string
  jobs: {
    jobs_title: string[]
    jobs_description: Job[]
  }
}
const title = experienceData.title
const { jobs_title: jobsTitle, jobs_description: jobsDescription } =
  experienceData.jobs

const normalizeTitle = title
  .toLowerCase()
  .replaceAll(' ', '-')
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
---

<section id={normalizeTitle} class="experience">
  <h2 set:html={accentHtml(title)} />
  <div class="jobs">
    <div
      class="job-title"
      role="tablist"
      aria-label={title}
      aria-orientation="vertical"
    >
      {
        jobsDescription.map((job, index) => (
          <button
            id={`job-tab-${index}`}
            class:list={['tabbutton', { active: index === 0 }]}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`job-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
          >
            <span class="company">{job.company}</span>
            <span class="role">{jobsTitle[index]}</span>
          </button>
        ))
      }
    </div>
    <div class="jobs-descriptions">
      {
        jobsDescription.map((job, index) => {
          const { title, organization, location, time, description, list } = job
          return (
            <div
              id={`job-panel-${index}`}
              class:list={[
                'description tabcontent glass',
                { active: index === 0 }
              ]}
              role="tabpanel"
              aria-labelledby={`job-tab-${index}`}
              tabindex="0"
              hidden={index !== 0}
            >
              <h3>{title}</h3>

              {(organization || location) && (
                <p class="job-organization">
                  {organization}
                  {organization && location ? ' · ' : ''}
                  {location}
                </p>
              )}

              <div class="job-time">
                {time.map((time, index) => (
                  <>
                    <time datetime={time}>{time}</time>
                    {index === 0 && <span aria-hidden="true">—</span>}
                  </>
                ))}
                {time.length <= 1 && <span class="badge">Actual</span>}
              </div>

              {description && <p>{description}</p>}
              <ul>
                {list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  h2 {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    white-space: nowrap;

    &::after {
      content: '';
      display: block;
      width: 100%;
      height: 1px;
      background-color: var(--border-color);
      transition: var(--transition-bg);
    }
  }

  .jobs {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-6);

    @media (width >= 900px) {
      flex-direction: row;
      align-items: start;
      gap: var(--space-6);
    }
  }

  .job-title {
    display: flex;
    flex-direction: row;
    overflow-x: auto;

    @media (width >= 900px) {
      flex-direction: column;
      flex: 0 0 280px;
    }

    & button {
      display: grid;
      gap: 2px;
      flex-shrink: 0;
      padding: var(--space-3) var(--space-4);
      background: transparent;
      color: var(--text-description-color);
      text-align: left;
      white-space: nowrap;
      cursor: pointer;
      border: none;
      border-bottom: 2px solid var(--border-color);
      transition: var(--transition-text), var(--transition-border);

      @media (width >= 900px) {
        border-bottom: none;
        border-left: 2px solid var(--border-color);
        white-space: normal;
      }

      &.active {
        color: var(--text-color);
        border-bottom: 3px solid var(--accent-color);

        @media (width >= 900px) {
          border-bottom: none;
          border-left: 3px solid var(--accent-color);
          padding-left: calc(var(--space-4) - 1px);
        }
      }

      &:focus-visible {
        outline: 2px solid var(--accent-color);
        outline-offset: -2px;
      }

      @media (any-hover: hover) {
        &:hover {
          color: var(--text-color);
        }
      }
    }

    & .company {
      font-size: var(--text-xl);
      font-weight: var(--w-semibold);
      letter-spacing: var(--tracking-heading);
    }

    & .role {
      font-size: var(--text-sm);
      color: var(--text-muted-color);
      transition: var(--transition-text);
    }
  }

  .jobs-descriptions {
    flex: 1;
    min-width: 0;
  }

  .description {
    display: none;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius);
    animation: fade 1200ms ease;

    &.active {
      display: block;
    }

    &:focus-visible {
      outline: 2px solid var(--accent-color);
      outline-offset: 2px;
    }

    & > * + *,
    & ul li {
      margin-top: var(--space-3);
    }

    & h3 {
      font-size: var(--text-2xl);
    }

    & .job-organization,
    & p,
    & ul {
      color: var(--text-description-color);
      transition: var(--transition-text);
    }

    & .job-time {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      color: var(--text-muted-color);

      & .badge {
        padding: 2px var(--space-2);
        font-size: var(--text-xs);
        color: var(--accent-color);
        border: 1px solid var(--accent-color);
        border-radius: var(--radius-pill);
        transition: var(--transition-text), var(--transition-border);
      }
    }

    & p {
      text-wrap: pretty;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const tabButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.tabbutton')
  )
  const tabContents = Array.from(
    document.querySelectorAll<HTMLDivElement>('.tabcontent')
  )

  const selectTab = (index: number, focus = false): void => {
    tabButtons.forEach((button, i) => {
      const selected = i === index
      button.classList.toggle('active', selected)
      button.setAttribute('aria-selected', String(selected))
      button.tabIndex = selected ? 0 : -1
    })
    tabContents.forEach((content, i) => {
      const selected = i === index
      content.classList.toggle('active', selected)
      content.hidden = !selected
    })
    if (focus) tabButtons[index].focus()
  }

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      selectTab(index)
    })

    // Flechas, Inicio y Fin mueven entre pestañas
    button.addEventListener('keydown', (event) => {
      const last = tabButtons.length - 1
      const keys: Record<string, number> = {
        ArrowDown: index === last ? 0 : index + 1,
        ArrowRight: index === last ? 0 : index + 1,
        ArrowUp: index === 0 ? last : index - 1,
        ArrowLeft: index === 0 ? last : index - 1,
        Home: 0,
        End: last
      }
      if (event.key in keys) {
        event.preventDefault()
        selectTab(keys[event.key], true)
      }
    })
  })
</script>
